{
  "name": "@hookfish/api",
  "version": "0.13.0",
  "description": "Mountable Hookfish Hono API",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/app.ts --format esm --dts --clean --sourcemap",
    "test": "tsx src/app.test.ts && tsx src/exa.test.ts && tsx src/headers.test.ts && tsx src/upstream.test.ts && tsx src/spec.test.ts && tsx src/mcp.test.ts && tsx src/self.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.1",
    "hono": "^4.11.4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
