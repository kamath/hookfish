{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"]
  },
    "include": ["src/**/*.ts", "src/**/*.d.ts", "drizzle.config.ts"]
}
