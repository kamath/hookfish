{
  "name": "hookfish-workspace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "cli": "pnpm build && pnpm --filter hookfish start",
    "dev": "turbo run dev --filter=@hookfish/web",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "wrangler": "^4.126.0"
  },
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp"
    ]
  }
}
