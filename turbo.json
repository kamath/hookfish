{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "web/**"]
    },
    "@hookfish/web#build:node": {
      "outputs": ["dist-node/**"]
    },
    "hookfish#build": {
      "dependsOn": ["@hookfish/web#build:node"],
      "outputs": ["dist/**", "web/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    }
  }
}
